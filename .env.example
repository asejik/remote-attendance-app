# Copy to .env and fill in. .env is gitignored; never commit real values.
# This file is for the DEV project. Production values live only in the GitHub
# "production" environment (see docs/deploy/GO_LIVE.md), never on a laptop.

# --- Web/Android app (bundled into the client; public by design) ---
# https://<project-ref>.supabase.co
VITE_SUPABASE_URL=
# publishable (anon) key. The ONLY key allowed in src/
VITE_SUPABASE_ANON_KEY=
# optional: error monitoring. Leave empty to turn Sentry off
VITE_SENTRY_DSN=
# optional: map tiles; default OpenStreetMap
VITE_MAP_TILE_URL=
# optional: attribution text for the tile provider
VITE_MAP_ATTRIBUTION=
# optional: 1 shows /diagnostics (test APK only)
VITE_ENABLE_DIAGNOSTICS=
# release APK only (set by android-release.yml): its version (git tag) and where version.json lives
VITE_APP_VERSION=
VITE_UPDATE_URL=

# --- Server-side tooling only (scripts, RLS tests). NEVER prefix with VITE_ ---
# same URL as above
SUPABASE_URL=
# secret (service-role) key: bypasses RLS. Dev only, read-only use
SUPABASE_SECRET_KEY=
# Supabase CLI personal token (db push, functions deploy, gen types)
SUPABASE_ACCESS_TOKEN=
# dev database password (supabase link / db push)
SUPABASE_DB_PASSWORD=
# shared secret for purge-expired-photos (same value as the function secret)
CRON_SECRET=

# --- Playwright E2E accounts on dev (tests skip without them) ---
E2E_STAFF_EMAIL=
E2E_STAFF_PASSWORD=
# (E2E_ADMIN_EMAIL / E2E_ADMIN_PASSWORD are no longer used: admin tests create their own admins)
# organisation slug of the E2E admin (demo)
E2E_ORG_SLUG=

# --- Optional ---
# read-only fine-grained token (Actions: read) for CI logs
GITHUB_LOGS_TOKEN=

# Set per command, not here:
#   SEED_ALLOW=dev                      seed-dev.mjs safety switch
#   REQUIRE_RLS_TESTS=1                 make test:rls fail instead of skip
#   ORG_NAME / ORG_SLUG / ADMIN_NAME / ADMIN_EMAIL / SITE_PHOTO_REQUIRED /
#   GEOFENCE_MODE / PHOTO_RETENTION_DAYS   onboard-org.mjs
#   PROJECT_REF / SITE_URL / REDIRECT_URLS / DISABLE_SIGNUP   configure-supabase.mjs
#   BASE_SHA                            check-migrations.mjs (CI sets it)
